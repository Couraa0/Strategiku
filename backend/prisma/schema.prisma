datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  UMKM_OWNER
}

enum OpportunityStatus {
  Aktif
  Terbuka
  Ditutup
  Proses_Seleksi
}

enum YesNoSyarat {
  Ya
  Tidak
  Dengan_Syarat
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  full_name     String
  role          UserRole @default(UMKM_OWNER)
  phone         String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt @default(now())

  profiles      BusinessProfile[]
  opportunities UMKMHubOpportunity[]
}

model BusinessProfile {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Section 1: Identitas UMKM
  nama_usaha        String
  nama_pemilik      String
  kabupaten_kota    String
  alamat_usaha      String   @db.Text
  tahun_mulai_usaha Int      @default(2020)
  deskripsi_usaha   String   @db.Text

  // Section 2: Kategori dan Kemampuan Usaha
  bidang_usaha String
  kategori     String
  target_pasar String
  kapasitas    String
  area_layanan String

  // Section 3: Pengalaman dan Kesiapan Kemitraan
  pengalaman_b2b                   String?      @db.Text
  pengalaman_pesanan_besar         String?      @db.Text
  legalitas_usaha                  String?      @db.Text
  kesediaan_memenuhi_pesanan_besar YesNoSyarat  @default(Ya)
  persyaratan_kemampuan_khusus     String?      @db.Text

  // Section 4: Preferensi Kemitraan
  jenis_peluang_diminati     String   @db.Text
  wilayah_peluang_diinginkan String   @db.Text
  minimal_pesanan            String
  maksimal_pesanan            String
  deskripsi_kerjasama        String   @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt @default(now())

  products        BusinessProduct[]
  recommendations UMKMRecommendation[]
}

model BusinessProduct {
  id               String          @id @default(uuid())
  profile_id       String
  profile          BusinessProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  nama_produk      String
  kategori         String
  harga            Float           @default(0)
  kapasitas        String
  satuan_penjualan String          @default("pcs")
  area_layanan     String

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt @default(now())
}

model UMKMHubOpportunity {
  id                String   @id @default(uuid())
  created_by        String?
  creator           User?    @relation(fields: [created_by], references: [id], onDelete: SetNull)

  judul_peluang     String
  nama_instansi     String
  lokasi            String
  kategori          String
  jumlah_dan_satuan String
  periode           String
  status            OpportunityStatus @default(Aktif)
  link_sumber       String
  deskripsi         String   @db.Text
  persyaratan       String?  @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt @default(now())

  recommendations UMKMRecommendation[]
}

model UMKMRecommendation {
  id             String              @id @default(uuid())
  profile_id     String
  profile        BusinessProfile     @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  opportunity_id String
  opportunity    UMKMHubOpportunity @relation(fields: [opportunity_id], references: [id], onDelete: Cascade)

  ranking            Int    @default(1)
  skor_relevansi     Float  @default(0.0)
  alasan_rekomendasi String @db.Text // Stored as JSON string

  created_at DateTime @default(now())

  @@unique([profile_id, opportunity_id])
}
